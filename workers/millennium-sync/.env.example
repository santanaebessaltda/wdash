# Supabase (Dashboard > Settings > API)
SUPABASE_URL=https://gjdslociicdkmjxxznyf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave que cifra a senha do ERP (a mesma das Edge Functions)
ERP_SECRET_KEY=

# API do Millennium
MILLENNIUM_API_BASE=http://177.85.160.35:6017/api

# Cada chave cuida de uma coisa so. Valor invalido impede o worker de iniciar.
# Periodos: off = desligado | Nd = N dias contando hoje (1d = so hoje, 2d = hoje e ontem)
#           Nm = N meses contando o atual (1m = mes atual, 2m = mes atual + anterior)
# Dias perdidos (integracao desconectada, worker parado) sao recuperados no proximo
# Atualizar ou fechamento da madrugada, sem depender de nenhuma chave abaixo.

# Carga do onboarding (padrao 2m = mes atual + anterior). off = sem vendas: ao conectar traz so o cadastro
# (equipe e produtos). Nao afeta as demais chaves.
SYNC_ONBOARDING=2m

# Atualizacao automatica a cada 30 min, o dia todo (padrao on). off = so o Atualizar manual.
AUTO_REFRESH=on

# Fechamento da madrugada: hora local em que comeca (0-23). off = desligado.
CLOSE_HOUR=2

# Historico antigo na madrugada, mes a mes ate a inauguracao da loja (padrao 24m; so Nm).
DEEP_HISTORY=24m

# Opcional: 1 = mostra no terminal cada etapa do sync (debug).
# SYNC_LOG_VERBOSE=1
