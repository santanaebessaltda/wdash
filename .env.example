# Copie para `.env` e preencha com o projeto Supabase
# (Settings → API: Project URL + anon public key).
# Nunca commite o `.env`. Nunca coloque a service_role no front.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Auth → URL Configuration: Site URL + Redirect URLs
# http://localhost:5173/**  e  http://localhost:5173/reset
# (ver supabase/README.md)

# Edge Function millennium-onboarding (secret no projeto Supabase, não no front):
# MILLENNIUM_API_BASE=http://177.85.160.35:6017/api

# AES key para cifrar senha ERP em erp_credential.password_ciphertext.
# Mesmo valor no Supabase secrets (Edge) e no worker BR. Nunca no VITE_*.
# ERP_SECRET_KEY=

# Push do PWA (só no worker, segredo do Fly). A chave pública está em src/push/vapidPublic.ts.
# VAPID_SUBJECT=mailto:wdash@wdash.app
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

